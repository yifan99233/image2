APP_NAME=image2-admin-server
APP_ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/image2
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

ADMIN_JWT_SECRET_KEY=change-me-admin-secret
ADMIN_JWT_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_JWT_AUDIENCE=image2-admin

ADMIN_RSA_PRIVATE_KEY=
ALLOW_PLAINTEXT_PASSWORD_LOGIN=true

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Qiniu Cloud: OpenAgent release package direct upload.
# Used by /admin/openagent/upload-token.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_BASE_URL=
QINIU_UPLOAD_HOST=https://upload.qiniup.com
OPENAGENT_RELEASE_PREFIX=openagent/releases

SITE_FRONTEND_ROOT_DOMAIN=shyfai.com
SITE_ADMIN_ROOT_DOMAIN=shyfai.com
SITE_FRONTEND_BASE_SUBDOMAIN=magic
SITE_ADMIN_BASE_SUBDOMAIN=magic-admin
SITE_FRONTEND_URL=https://magic.shyfai.com
SITE_HOST_ROOT_DOMAIN_ALIASES=shyfai.com,shyfai.cn
