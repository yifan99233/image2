{
  "name": "image2-user-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:recharge-access": "node --test tests/rechargeAccess.ui.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:ccswitch": "node --experimental-strip-types --test src/utils/ccswitch.test.mjs",
    "test:download": "node --experimental-strip-types --test src/utils/downloadTarget.test.mjs tests/streamingDownload.test.mjs",
    "test:browser-export": "node --experimental-strip-types --test src/utils/browserBatchExport.test.mjs",
    "test:image-edit": "node --experimental-strip-types --test src/utils/imageEditNavigation.test.mjs",
    "test:auth-invite": "node --experimental-strip-types --test src/utils/authInviteContext.test.mjs",
    "test:preview": "node --experimental-strip-types --test src/utils/assetPreview.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:canvas": "npm --prefix ../canvas-web run build",
    "prebuild": "npm run build:canvas",
    "predev": "npm run build:canvas",
    "test:batch-groups": "node --experimental-strip-types --test src/utils/batchGroups.test.mjs src/utils/batchPrompts.test.mjs src/utils/batchGroupUploads.test.mjs && node --test tests/batchGroups.ui.test.mjs tests/imageBatchSubmission.test.mjs",
    "test:image-output": "node --test tests/imageOutputSettings.ui.test.mjs tests/imageBatchSubmission.test.mjs",
    "test:workbench-previews": "node --test tests/workbenchPreviews.ui.test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@zip.js/zip.js": "2.23.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "0.25.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
