# Deployment identity and host-only paths. Keep the real file outside Git.
COMPOSE_PROJECT_NAME=sub2api-agent2
CONTAINER_PREFIX=sub2api-agent2
HOST_PORT=8081
DATA_ROOT=/srv/sub2api-agent2
RUNTIME_ENV_FILE=/srv/sub2api-agent2/.env

# Application runtime values. Replace every placeholder in the real file.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-runtime-secret
POSTGRES_DB=sub2api
REDIS_PASSWORD=
REDIS_DB=0
TZ=Asia/Shanghai
JWT_SECRET=replace-with-runtime-secret
TOTP_ENCRYPTION_KEY=replace-with-runtime-secret
