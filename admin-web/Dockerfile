FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci

COPY . .

ARG VITE_ADMIN_API_BASE_URL=/admin-api
ENV VITE_ADMIN_API_BASE_URL=${VITE_ADMIN_API_BASE_URL}
ARG VITE_SITE_FRONTEND_ROOT_DOMAIN=shyfai.cn
ENV VITE_SITE_FRONTEND_ROOT_DOMAIN=${VITE_SITE_FRONTEND_ROOT_DOMAIN}
ARG VITE_SITE_ADMIN_ROOT_DOMAIN=shyfai.cn
ENV VITE_SITE_ADMIN_ROOT_DOMAIN=${VITE_SITE_ADMIN_ROOT_DOMAIN}
ARG VITE_SITE_FRONTEND_BASE_SUBDOMAIN=magic
ENV VITE_SITE_FRONTEND_BASE_SUBDOMAIN=${VITE_SITE_FRONTEND_BASE_SUBDOMAIN}
ARG VITE_SITE_ADMIN_BASE_SUBDOMAIN=magic-admin
ENV VITE_SITE_ADMIN_BASE_SUBDOMAIN=${VITE_SITE_ADMIN_BASE_SUBDOMAIN}
ARG VITE_SITE_FRONTEND_URL=https://magic.shyfai.cn
ENV VITE_SITE_FRONTEND_URL=${VITE_SITE_FRONTEND_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
