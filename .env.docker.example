# Copy to .env before running docker compose if you want to override defaults.

POSTGRES_DB=image2
POSTGRES_USER=image2
POSTGRES_PASSWORD=image2_dev_password
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=600

REDIS_PORT=6379

USER_SERVER_PORT=8000
ADMIN_SERVER_PORT=8001
USER_WEB_PORT=3000
USER_WEB_BIND_ADDRESS=127.0.0.1
ADMIN_WEB_PORT=3001

USER_DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@postgres:5432/image2
ADMIN_DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@postgres:5432/image2
USER_REDIS_URL=redis://redis:6379/0
ADMIN_REDIS_URL=redis://redis:6379/1
# Keep one user-server worker below 80 PostgreSQL connections by default.
# Increase only after measuring database CPU, memory, and max_connections.
USER_DATABASE_POOL_SIZE=40
USER_DATABASE_MAX_OVERFLOW=40
USER_DATABASE_POOL_TIMEOUT_SECONDS=30
USER_REDIS_MAX_CONNECTIONS=100
USER_IMAGE_TASK_QUEUE_LIMIT_PER_USER=20000

# 生图并发：这些值是每个 Uvicorn worker 的上限，按上游能力和 worker 数量调大。
USER_IMAGE_TASK_GENERATION_THREAD_POOL_SIZE=64
USER_IMAGE_TASK_STORAGE_THREAD_POOL_SIZE=64
USER_IMAGE_TASK_GENERATION_MAX_INFLIGHT=64
USER_IMAGE_TASK_DISPATCHER_BATCH_SIZE=64
USER_IMAGE_TASK_DISPATCHER_MAX_INFLIGHT=64
# ZIP export safety cap for the uncompressed result payload (512 MiB).
USER_IMAGE_EXPORT_MAX_BYTES=536870912
IMAGE_EXPORT_STREAM_MAX_BYTES=107374182400
BATCH_UPLOAD_MAX_BYTES=67108864
USER_IMAGE_VIDEO_DOWNLOAD_MAX_BYTES=268435456
USER_IMAGE_PROVIDER_RESPONSE_MAX_BYTES=67108864
# 本机直接启动服务调试时可复制下面 host 写法到 .env，改成目标远端 DB/Redis。
# USER_DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@<remote-host>:5432/image2
# ADMIN_DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@<remote-host>:5432/image2
# USER_REDIS_URL=redis://:<redis-password>@<remote-host>:6379/0
# ADMIN_REDIS_URL=redis://:<redis-password>@<remote-host>:6379/1
USER_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3001,http://127.0.0.1:3001
SITE_HOST_ROOT_DOMAIN_ALIASES=shyfai.cn
SITE_FRONTEND_ROOT_DOMAIN=shyfai.cn
SITE_ADMIN_ROOT_DOMAIN=shyfai.com
SITE_FRONTEND_BASE_SUBDOMAIN=magic
SITE_ADMIN_BASE_SUBDOMAIN=magic-admin
SITE_FRONTEND_URL=https://magic.shyfai.cn

USER_JWT_SECRET_KEY=change-this-user-jwt-secret-32chars
ADMIN_JWT_SECRET_KEY=change-this-admin-jwt-secret-32chars
USER_TEAM_INVITE_TOKEN_EXPIRE_DAYS=30

# Keep plaintext login enabled for local development while RSA key management is incomplete.
# Set these to false in production after configuring PASSWORD_RSA_PRIVATE_KEY / ADMIN_RSA_PRIVATE_KEY.
USER_ALLOW_PLAINTEXT_PASSWORD=true
ADMIN_ALLOW_PLAINTEXT_PASSWORD_LOGIN=true

USER_MINIO_ENDPOINT=minio:9000
USER_MINIO_PUBLIC_ENDPOINT=https://magic.shyfai.cn
USER_MINIO_BUCKET=image2-assets
# 本机直接启动服务调试时复制下面 host 写法到 .env。
# USER_MINIO_ENDPOINT=<remote-host>:9002

# Optional Cloudflare R2 hot layer for browser uploads and fresh generated images.
# Keep these values in the deployment secret store, not in the repository.
USER_R2_ENABLED=false
USER_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
USER_R2_ACCESS_KEY_ID=
USER_R2_SECRET_ACCESS_KEY=
USER_R2_BUCKET=
USER_R2_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
USER_R2_UPLOAD_EXPIRES_SECONDS=900
USER_R2_HOT_URL_TTL_SECONDS=259200

# Image storage: leave as minio to keep local development self-contained.
# Set to qiniu in production to store new uploads and generated images in Qiniu.
USER_UPLOAD_STORAGE_PROVIDER=minio
USER_QINIU_IMAGE_PREFIX=image2-assets
# For multiple vendors or CDN domains, define named storage targets as JSON and choose one.
# Existing asset URLs continue using their original domains after a target switch.
# USER_IMAGE_STORAGE_TARGET=qiniu-primary
# USER_IMAGE_STORAGE_TARGETS_JSON={"qiniu-primary":{"provider":"qiniu","bucket":"image-primary","cdn_base_url":"https://img-primary.example.com","key_prefix":"image2-assets","access_key":"...","secret_key":"...","upload_host":"https://upload.qiniup.com"}}

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Qiniu Cloud: OpenAgent release package direct upload.
# Used by admin-server /admin/openagent/upload-token. The browser uploads
# packages directly to Qiniu, and admin only stores the public download URL.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_BASE_URL=
QINIU_UPLOAD_HOST=https://upload.qiniup.com
OPENAGENT_RELEASE_PREFIX=openagent/releases
