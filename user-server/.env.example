APP_NAME=image2-user-server
DEBUG=true

DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@postgres:5432/image2
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
IMAGE_EXPORT_MAX_BYTES=536870912
IMAGE_TASK_QUEUE_LIMIT_PER_USER=2000
IMAGE_VIDEO_DOWNLOAD_MAX_BYTES=268435456
IMAGE_PROVIDER_RESPONSE_MAX_BYTES=67108864
# 本机直接启动 user-server 调试时复制下面 host 写法，保持连接同一套 DB/Redis/MinIO。
# DATABASE_URL=postgresql+asyncpg://image2:image2_dev_password@110.42.48.35:5432/image2
# REDIS_URL=redis://:<redis-password>@110.42.48.35:6379/0
CORS_ORIGINS=*
CORS_ORIGIN_REGEX=.*
SITE_HOST_ROOT_DOMAIN_ALIASES=shyfai.cn

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

PASSWORD_RSA_PRIVATE_KEY=
ALLOW_PLAINTEXT_PASSWORD=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://magic.shyfai.cn
# 本机直接启动 user-server 调试时复制下面 host 写法。
# MINIO_ENDPOINT=110.42.48.35:9002
MINIO_ACCESS_KEY=image2minio
MINIO_SECRET_KEY=image2minio123
MINIO_BUCKET=image2-assets
MINIO_SECURE=false
MINIO_PUBLIC_READ=true

# Optional Cloudflare R2 hot layer. The browser uploads directly to R2,
# while user-server writes a MinIO backup after confirming the upload.
USER_R2_ENABLED=false
USER_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
USER_R2_ACCESS_KEY_ID=
USER_R2_SECRET_ACCESS_KEY=
USER_R2_BUCKET=
USER_R2_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
USER_R2_UPLOAD_EXPIRES_SECONDS=900
USER_R2_HOT_URL_TTL_SECONDS=259200
